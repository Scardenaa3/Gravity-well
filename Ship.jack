/**
 * Ship: la nave del jugador y toda su fisica.
 *
 * Posicion y velocidad en punto fijo (1/16 de pixel):
 *   px, py : posicion      (pixel = px / 16)
 *   vx, vy : velocidad     (1/16 de pixel por frame)
 *
 * Cada frame: entrada de teclado -> gravedad de cada planeta ->
 * integracion (p = p + v) -> rebote en los bordes -> dibujo.
 */
class Ship {
    field int px, py;
    field int vx, vy;
    field int cooldown;      // frames restantes para volver a usar el impulso

    constructor Ship new() {
        do reset();
        return this;
    }

    /** Coloca la nave en su posicion inicial, en reposo. */
    method void reset() {
        let px = 1440;       // x = 90 px
        let py = 2160;       // y = 135 px
        let vx = 0;
        let vy = 0;
        let cooldown = 0;
        do draw();
        return;
    }

    method int getX() { return px / 16; }
    method int getY() { return py / 16; }
    method boolean ready() { return cooldown = 0; }

    method void draw() {
        do Screen.setColor(true);
        do Screen.drawCircle(px / 16, py / 16, Config.shipRadius());
        return;
    }

    method void erase() {
        do Screen.setColor(false);
        do Screen.drawCircle(px / 16, py / 16, Config.shipRadius());
        return;
    }

    /**
     * Entrada NO bloqueante: Keyboard.keyPressed() devuelve de inmediato
     * el codigo de la tecla pulsada (0 si no hay ninguna).
     * 130 izq, 131 arriba, 132 der, 133 abajo, 32 espacio.
     */
    method void applyInput(int key) {
        var int t;
        let t = Config.thrust();
        if (cooldown > 0) { let cooldown = cooldown - 1; }
        if (key = 130) { let vx = vx - t; }
        if (key = 132) { let vx = vx + t; }
        if (key = 131) { let vy = vy - t; }
        if (key = 133) { let vy = vy + t; }
        if ((key = 32) & (cooldown = 0)) {
            let vx = vx + Config.boost();          // impulso frontal
            let cooldown = Config.boostCooldown();
        }
        return;
    }

    /**
     * Atraccion gravitacional de un planeta (ley 1/r de un universo 2D):
     *   a = m / d      con componentes   ax = m * dx / d^2,  ay = m * dy / d^2
     * Solo se calcula dentro del alcance de la gravedad; asi dx^2 + dy^2
     * nunca desborda los 16 bits (maximo 100^2 + 100^2 = 20000 < 32767).
     * Se opera con valores absolutos y se restaura el signo a mano para
     * no depender de la division con numeradores negativos.
     * Devuelve true si la nave choca con el planeta.
     */
    method boolean pullFrom(Planet p) {
        var int dx, dy, d2, rr, ax, ay, m;
        let dx = p.getX() - (px / 16);
        let dy = p.getY() - (py / 16);
        if ((Math.abs(dx) < Config.gravityRange()) & (Math.abs(dy) < Config.gravityRange())) {
            let d2 = (dx * dx) + (dy * dy);
            let rr = p.getRadius() + Config.shipRadius() + 1;   // +1 px de margen
            if (d2 < (rr * rr)) { return true; }                // colision
            let m = p.getMass();
            let ax = Math.divide(Math.multiply(m, Math.abs(dx)), d2);
            let ay = Math.divide(Math.multiply(m, Math.abs(dy)), d2);
            if (dx < 0) { let ax = -ax; }
            if (dy < 0) { let ay = -ay; }
            let vx = vx + ax;
            let vy = vy + ay;
        }
        return false;
    }

    /** Integra el movimiento, aplica rebotes y redibuja. */
    method void move() {
        do erase();
        let vx = Ship.limit(vx, Config.maxSpeed());
        let vy = Ship.limit(vy, Config.maxSpeed());
        let px = px + vx;
        let py = py + vy;
        // Rebote con perdida de energia (se conserva 3/4 de la velocidad).
        // Limites en 1/16 px: x en [4, 507] -> [64, 8112], y en [20, 251] -> [320, 4016]
        if (px < 64)   { let px = 64;   let vx = Ship.rebound(vx); }
        if (px > 8112) { let px = 8112; let vx = -Ship.rebound(vx); }
        if (py < 320)  { let py = 320;  let vy = Ship.rebound(vy); }
        if (py > 4016) { let py = 4016; let vy = -Ship.rebound(vy); }
        do draw();
        return;
    }

    /** Limita v al rango [-m, m]. */
    function int limit(int v, int m) {
        if (v > m) { return m; }
        if (v < (-m)) { return -m; }
        return v;
    }

    /** Magnitud de la velocidad tras un rebote: |v| * 3 / 4. */
    function int rebound(int v) {
        return Math.divide(Math.multiply(Math.abs(v), 3), 4);
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
